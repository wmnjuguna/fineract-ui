# Deployment and local environment template.
# Copy this file to .env.local for local development, or map these variables in
# the target deployment environment. Do not commit real secrets or
# environment-specific credentials.

# NextAuth/Auth.js
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Keycloak OIDC tenant realms
# The app is OIDC-only. AUTH_LOGIN_MODE is intentionally not used.
#
# Users enter a tenant ID on /auth/signin. For tenant "default", the issuer is:
#   ${AUTH_KEYCLOAK_BASE_URL}/realms/default
AUTH_KEYCLOAK_BASE_URL=http://127.0.0.1:18080
AUTH_KEYCLOAK_ID=fineract-ui
AUTH_KEYCLOAK_DEFAULT_TENANT=default

# Set only when the Keycloak client is confidential.
# Leave empty/unset for a public PKCE client.
# AUTH_KEYCLOAK_SECRET=

# Fineract API
FINERACT_BASE_URL=https://localhost:8443/fineract-provider/api

# Service credentials used only by server-side endpoints that explicitly request
# service-account Basic auth after a valid OIDC session is present.
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password

# Local-only escape hatch for self-signed Fineract HTTPS certificates.
# Do not use this in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
